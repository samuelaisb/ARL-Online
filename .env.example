# Required for member approval/refusal emails (server starts without it; those emails fail until set)
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=noreply@activistresourcelibrary.com
# Optional — Reply-To on every app email except the contact form (which replies to the visitor).
# activistresourcelibrary.com receives no mail, so replies default to samuel@apathyisboring.com.
# One address, no commas (npm run cloud:build passes it in a comma-separated list).
# EMAIL_REPLY_TO=samuel@apathyisboring.com
# Optional — office line in transactional email footers (defaults live in src/lib/email-brand.js).
# ORG_ADDRESS includes a comma, so npm run cloud:build does not pass it, and a value set by hand on Cloud Run
# is wiped by the next cloud:build deploy (--set-env-vars replaces the list). Change the default in code instead.
# ORG_ADDRESS=5310 Boulevard Saint-Laurent, Montréal QC H2T 1S1
# ORG_PHONE=514.844.2472
# Optional — government funder logo strip on YES Employment consultation emails (600px wide PNG).
# EMAIL_FUNDER_LOGO_URL=https://example.com/govt_funding_logo_en_fr.png
# Optional — Slack workflow trigger webhook for new reservations (text variables only)
# SLACK_RESERVATION_WEBHOOK_URL=https://hooks.slack.com/triggers/...
PORT=3000

# Supabase — server + runtime client auth via GET /config.js (primary path for the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_API=your-anon-key
# Optional Vite build-time aliases (Docker/Cloud Build build args, or npm run dev:client without Express)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role (server only — never expose to the browser or Docker build args)
# Required for inventory + reservations. Apply supabase/migrations/001–007 in order first.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL for Supabase email-confirmation redirects and Resend email links/images.
# Omit locally to use the current origin (e.g. http://localhost:5173) in the browser; emails
# fall back to https://activistresourcelibrary.com when unset. Also add this URL under
# Supabase → Authentication → URL Configuration (Site URL + Redirect URLs).
SITE_URL=https://activistresourcelibrary.com

# Optional — Zoom Server-to-Server OAuth app for expertise consultation meetings.
# When unset, consultations still schedule but no Zoom meeting is created.
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# Optional — Zoom user that hosts meetings (email or user id); defaults to "me" (the app owner)
# ZOOM_HOST_USER=me

# Optional — Plausible analytics domain (injects script + allows CSP when set)
# PLAUSIBLE_DOMAIN=activistresourcelibrary.com
